# Copy to .env.local and fill in. NEXT_PUBLIC_ ones are public (sent to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase anon / publishable key>
# Google Maps JavaScript API key (restrict it to your domains in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Crash reports (Sentry, EU region). Leave empty to turn them off.
NEXT_PUBLIC_SENTRY_DSN=
# Only for uploading source maps at build time (Vercel only, not public):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Usage counts (PostHog EU project API key, starts with phc_). Leave empty to turn them off.
NEXT_PUBLIC_POSTHOG_KEY=
